# ── Zoho OAuth ──────────────────────────────────────────────────────────────
# Get these from Zoho API Console → https://api-console.zoho.com/
# Required scope: ZohoCreator.report.READ, ZohoCreator.form.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ── Zoho Creator Config ──────────────────────────────────────────────────────
ZOHO_OWNER=straydoginstitute
ZOHO_APP=stray-dog-institute
ZOHO_DOMAIN=zoho.com

# ── Form / Report names (defaults match current setup) ──────────────────────
ZOHO_SURVEY_FORM=State_of_the_Movement_Survey
ZOHO_SURVEY_REPORT=State_of_the_Movement_Survey_Report
ZOHO_GRANT_CYCLE_REPORT=All_Grant_Cycle
ZOHO_EMAIL_FIELD=What_is_your_work_email_address
ZOHO_YEAR_FIELD=Current_Year
ZOHO_CYCLE_FIELD=Grant_Cycle

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://aristoraj.github.io
